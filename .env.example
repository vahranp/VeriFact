# Local Ollama by default: no API key, no cost, no network dependency.
# `ollama pull llama3.1:8b` (or any other instruction-tuned model) before running.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_API_KEY=

EXTRACTION_MODEL=llama3.1:8b
REASONING_MODEL=llama3.1:8b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OLLAMA_NUM_CTX=8192

DB_PATH=storage/facts.db
UPLOAD_DIR=data/uploads

# --- To use a hosted provider instead (OpenRouter, OpenAI, etc.) ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your-key-here
# EXTRACTION_MODEL=openai/gpt-4o-mini
# REASONING_MODEL=anthropic/claude-sonnet-4.5
